{
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/escalations",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/summaries",
      "schedule": "30 17 * * 1-5"
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/" }
  ]
}
