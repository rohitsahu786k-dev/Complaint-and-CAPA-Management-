{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':(exclude)*.md' ':(exclude)docs/**' ':(exclude).github/**'",
  "git": {
    "deploymentEnabled": {
      "fix/phase-compliance-hardening-20260908": false
    }
  },
  "functions": {
    "api/index.js": { "maxDuration": 60 }
  },
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/cron/escalations",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/summaries",
      "schedule": "30 17 1 * *"
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/" }
  ]
}
